{
  "name": "presente-casamento-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "contract:update": "node scripts/update-contract.mjs && npm run contract:types",
    "contract:types": "openapi-typescript openapi/openapi.json -o src/generated/api-schema.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^6.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "openapi-typescript": "^7.8.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
