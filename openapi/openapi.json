  "info": {
    "title": "Presente de Casamento API",
    "description": "API de listas, RSVP e pagamentos via Mercado Pago.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "wedding_session"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 100
          },
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 100
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "CreateListDto": {
        "type": "object",
        "properties": {
          "coupleNames": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "weddingDate": {
            "type": "string"
          }
        },
        "required": [
          "coupleNames",
          "title"
        ]
      },
      "UpdateListDto": {
        "type": "object",
        "properties": {
          "coupleNames": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "weddingDate": {
            "type": "string",
            "nullable": true
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      },
      "ListStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PUBLISHED",
              "DRAFT",
              "ARCHIVED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "InviteDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "CreateGiftDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "priceCents": {
            "type": "number",
            "minimum": 1,
            "maximum": 2147483647
          },
          "sortOrder": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "priceCents"
        ]
      },
      "UpdateGiftDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "priceCents": {
            "type": "number",
            "minimum": 1,
            "maximum": 2147483647
          },
          "sortOrder": {
            "type": "number",
            "minimum": 0
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "CreateIntentionDto": {
        "type": "object",
        "properties": {
          "giftId": {
            "type": "string"
          },
          "guestName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "guestEmail": {
            "type": "string",
            "format": "email"
          },
          "message": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "giftId",
          "guestName"
        ]
      },
      "CreateRsvpDto": {
        "type": "object",
        "properties": {
          "guestName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "guestEmail": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          },
          "attendance": {
            "type": "string",
            "enum": [
              "YES",
              "NO"
            ]
          }
        },
        "required": [
          "guestName",
          "guestEmail",
          "attendance"
        ]
      },
      "ConfirmRsvpDto": {
        "type": "object",
        "properties": {
          "guestEmail": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "guestEmail",
          "code"
        ]
      },
      "ResendRsvpConfirmationDto": {
        "type": "object",
        "properties": {
          "guestEmail": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          }
        },
        "required": [
          "guestEmail"
        ]
      },
      "CreateRsvpEventDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "eventDate": {
            "type": "string"
          },
          "responseDeadline": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "OPEN",
              "RESERVED"
            ]
          },
          "companionGroups": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "customFields": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "isOpen": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "responseDeadline",
          "mode",
          "companionGroups",
          "customFields"
        ]
      },
      "UpdateRsvpEventDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "eventDate": {
            "type": "string",
            "nullable": true
          },
          "responseDeadline": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "OPEN",
              "RESERVED"
            ]
          },
          "companionGroups": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "customFields": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "isOpen": {
            "type": "boolean"
          }
        }
      },
      "CreateRsvpGuestDto": {
        "type": "object",
        "properties": {
          "guestName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "phone": {
            "type": "string",
            "maxLength": 30
          },
          "guestEmail": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          },
          "companionAllowance": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "guestName",
          "phone"
        ]
      },
      "ImportRsvpGuestRowDto": {
        "type": "object",
        "properties": {
          "guestName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "phone": {
            "type": "string",
            "maxLength": 30
          },
          "guestEmail": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          },
          "companionAllowance": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "guestName",
          "phone"
        ]
      },
      "ImportRsvpGuestsDto": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImportRsvpGuestRowDto"
            }
          }
        },
        "required": [
          "rows"
        ]
      },
      "SendRsvpLinksDto": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "NEW",
              "PENDING"
            ]
          }
        },
        "required": [
          "scope"
        ]
      },
      "OpenRsvpLinkDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "maxLength": 30
          }
        },
        "required": [
          "phone"
        ]
      },
      "SubmitRsvpResponseDto": {
        "type": "object",
        "properties": {
          "guestName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "attendance": {
            "type": "string",
            "enum": [
              "YES",
              "NO"
            ]
          },
          "companionCounts": {
            "type": "object",
            "additionalProperties": true
          },
          "customAnswers": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "attendance"
        ]
      },
      "RsvpMessageStatusDto": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "maxLength": 120
          },
          "channel": {
            "type": "string",
            "enum": [
              "WHATSAPP",
              "SMS"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "SENT",
              "DELIVERED",
              "FAILED"
            ]
          }
        },
        "required": [
          "messageId",
          "channel",
          "status"
        ]
      },
      "CreatePaymentDto": {
        "type": "object",
        "properties": {
          "giftId": {
            "type": "string",
            "minLength": 1
          },
          "payerName": {
            "type": "string",
            "minLength": 2
          },
          "payerEmail": {
            "type": "string",
            "format": "email"
          },
          "method": {
            "type": "string",
            "enum": [
              "PIX",
              "CREDIT_CARD"
            ]
          },
          "amountCents": {
            "type": "number",
            "minimum": 100,
            "maximum": 10000000
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 16
          }
        },
        "required": [
          "giftId",
          "payerName",
          "payerEmail",
          "method",
          "amountCents",
          "idempotencyKey"
        ]
      },
      "ReceivedPaymentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "giftName": {
            "type": "string"
          },
          "payerName": {
            "type": "string"
          },
          "payerEmail": {
            "type": "string",
            "nullable": true
          },
          "amountCents": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "method": {
            "enum": [
              "PIX",
              "CREDIT_CARD"
            ],
            "type": "string"
          },
          "providerPaymentMethodId": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "enum": [
              "APPROVED",
              "REFUNDED"
            ],
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "confirmedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "providerTransactionId": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "giftName",
          "payerName",
          "payerEmail",
          "amountCents",
          "currency",
          "method",
          "providerPaymentMethodId",
          "status",
          "createdAt",
          "confirmedAt",
          "providerTransactionId"
        ]
      },
      "ReceivedPaymentsPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReceivedPaymentDto"
            }
          },
          "total": {
            "type": "number"
          },
          "approvedTotal": {
            "type": "number"
          },
          "refundedTotal": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "total",
          "approvedTotal",
          "refundedTotal",
          "page",
          "limit"
        ]
      }
    }
  }
}
