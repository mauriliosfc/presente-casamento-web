  "info": {
    "title": "Presente de Casamento API",
    "description": "API de listas e intenções de presentear. Não processa pagamentos.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "wedding_session"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 100
          },
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 100
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "CreateListDto": {
        "type": "object",
        "properties": {
          "coupleNames": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "weddingDate": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "coupleNames",
          "title"
        ]
      },
      "UpdateListDto": {
        "type": "object",
        "properties": {
          "coupleNames": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "weddingDate": {
            "type": "string",
            "nullable": true
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      },
      "ListStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PUBLISHED",
              "DRAFT",
              "ARCHIVED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "InviteDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "CreateGiftDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "priceCents": {
            "type": "number",
            "minimum": 1,
            "maximum": 2147483647
          },
          "sortOrder": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "priceCents"
        ]
      },
      "UpdateGiftDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "priceCents": {
            "type": "number",
            "minimum": 1,
            "maximum": 2147483647
          },
          "sortOrder": {
            "type": "number",
            "minimum": 0
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "CreateIntentionDto": {
        "type": "object",
        "properties": {
          "giftId": {
            "type": "string"
          },
          "guestName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "guestEmail": {
            "type": "string",
            "format": "email"
          },
          "message": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "giftId",
          "guestName"
        ]
      },
      "CreateRsvpDto": {
        "type": "object",
        "properties": {
          "guestName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "guestEmail": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          },
          "attendance": {
            "type": "string",
            "enum": [
              "YES",
              "NO"
            ]
          }
        },
        "required": [
          "guestName",
          "guestEmail",
          "attendance"
        ]
      },
      "ConfirmRsvpDto": {
        "type": "object",
        "properties": {
          "guestEmail": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "guestEmail",
          "code"
        ]
      },
      "ResendRsvpConfirmationDto": {
        "type": "object",
        "properties": {
          "guestEmail": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          }
        },
        "required": [
          "guestEmail"
        ]
      }
    }
  }
}
